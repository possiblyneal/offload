[Unit]
Description=Check offload's remotes and recent jobs, and report to the homelab panel
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# homelab-notify lives in ~/.local/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/offload health --notify
# One test job per remote; a lost remote ends its job within offload's own timeouts.
TimeoutStartSec=5min
